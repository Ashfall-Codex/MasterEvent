<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>3.0.1.1113</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WarningsAsErrors>$(WarningsAsErrors);CS0618</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\MasterEventIcons.ttf" />
    <EmbeddedResource Include="Resources\changelog-fr.json" WithCulture="false" LogicalName="MasterEvent.Resources.changelog-fr.json" />
    <EmbeddedResource Include="Resources\changelog-en.json" WithCulture="false" LogicalName="MasterEvent.Resources.changelog-en.json" />
    <EmbeddedResource Include="Resources\Web\index.html" WithCulture="false" LogicalName="MasterEvent.Resources.Web.index.html" />
    <EmbeddedResource Include="Resources\Web\app.css" WithCulture="false" LogicalName="MasterEvent.Resources.Web.app.css" />
    <EmbeddedResource Include="Resources\Web\player.html" WithCulture="false" LogicalName="MasterEvent.Resources.Web.player.html" />
    <EmbeddedResource Include="Resources\Web\player.css" WithCulture="false" LogicalName="MasterEvent.Resources.Web.player.css" />
    <EmbeddedResource Include="Resources\Web\gm\*.js" WithCulture="false" LogicalName="MasterEvent.Resources.WebModules.Gm.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources\Web\player\*.js" WithCulture="false" LogicalName="MasterEvent.Resources.WebModules.Player.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="DotNet.ReproducibleBuilds" Version="2.0.2" />
    <PackageReference Include="Glamourer.Api" Version="2.8.1" />
    <PackageReference Include="LuminaSupplemental.Excel" Version="5.1.5" />
    <PackageReference Include="Penumbra.Api" Version="5.15.1" />
    <PackageReference Include="K4os.Compression.LZ4.Legacy" Version="1.3.8" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="TerraFX.Interop.Windows">
      <HintPath>$(DalamudLibPath)TerraFX.Interop.Windows.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
